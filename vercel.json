{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "transfer-data.js", "use": "@vercel/static" },
    { "src": "course-catalog.js", "use": "@vercel/static" },
    { "src": "admissions-cases.js", "use": "@vercel/static" },
    { "src": "terms-privacy-pricing.html", "use": "@vercel/static" },
    { "src": "logo.png", "use": "@vercel/static" },
    { "src": "preview.png", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "academic_coverage_map.png", "use": "@vercel/static" },
    { "src": "eligibility_diagnostics.png", "use": "@vercel/static" },
    { "src": "prerequisite_finder.png", "use": "@vercel/static" },
    { "src": "roadmap_builder.png", "use": "@vercel/static" },
    { "src": "essay_strategist.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
